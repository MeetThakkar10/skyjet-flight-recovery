# Local MongoDB (e.g. the server backing MongoDB Compass). Leave unset to auto-start
# an in-memory MongoDB instead (data won't persist across server restarts).
MONGODB_URI=mongodb://127.0.0.1:27017/skyjet-flight-recovery
PORT=4000

# Comma-separated list of allowed frontend origins for credentialed CORS (cookies).
# Include every deployed frontend URL here (e.g. Vercel), not just localhost.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-app.vercel.app

# Secret used to sign auth JWTs. Change this in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string

# Mistral API key for the "Talk to an agent" chatbot. Get one at https://console.mistral.ai
MISTRAL_API_KEY=
